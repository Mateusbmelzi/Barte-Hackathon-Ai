# Copie para .env (não versionado) e preencha UMA das opções abaixo.
#
# Opção 1 - OpenRouter (não precisa da biblioteca anthropic):
#   OPENROUTER_API_KEY=sk-or-...
#   (uma chave "sk-or-..." colocada em ANTHROPIC_API_KEY também é reconhecida como OpenRouter)
OPENROUTER_API_KEY=
#
# Opção 2 - Anthropic direto (requer: pip install -r requirements-ia.txt):
ANTHROPIC_API_KEY=
